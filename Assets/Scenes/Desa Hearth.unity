  eyeTexture: {fileID: 2800000, guid: d49403773b0327144947ab8255c7b852, type: 3}
  hairTexture: {fileID: 2800000, guid: 1798ec1906464e24d82d87400290a734, type: 3}
  accessoryTexture: {fileID: 0}
  npcName: Doran
  dialogueLines:
  - Aku Doran, penjaga gerbang. Tidak ada seorang pun yang pernah keluar hidup-hidup
    dari hutan itu.
  - Lentera itu... Tetua harus melihatnya. Dia tahu asal cahayanya.
  - Kabut pernah menelan desa kami. Aku gagal melindungi mereka. Kali ini aku akan
    ikut denganmu.
  interactionDistance: 3.5
  characterScale: 1
  characterTint: {r: 1, g: 1, b: 1, a: 1}
